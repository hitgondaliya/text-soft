# Build output — regenerated by `dotnet build`, and the config under bin/ is a
# copy of assets/config, so committing it would give two sources of truth.
bin/
obj/
.vs/

# Publish/installer artefacts
dist/
installer/output/
*.zip

# Node
node_modules/
.next/

# Local machine state
*.user
*.suo

# Client font packs dropped in the repo root for analysis (commercial fonts; never commit)
/Gujarati font/
/hindi/
/*.rar

# Agent worktrees (local scratch copies of the repo)
.claude/worktrees/
