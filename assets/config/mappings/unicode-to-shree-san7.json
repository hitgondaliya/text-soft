  "postRules": [
    {
      "pattern": "\uFDDD",
      "replace": "",
      "note": "U\u002BFDDD stands for a joiner: no glyph, and nothing for the rules below to stop at."
    },
    {
      "pattern": "([DFJKLM])\\\u003E\u00F8",
      "replace": "$1~\u003E",
      "note": "Ra-sign under \u0919 \u091B \u091F \u0920 \u0921 \u0922: 7E, before the spacer (the signs below stay after it)."
    },
    {
      "pattern": "(a)\u00F8",
      "replace": "$1~",
      "note": "Ra-sign under \u0933: 7E."
    },
    {
      "pattern": "\u00A1((?:[stw%\u00F8no]|[uvxyz]|\u00EA)\u002B)",
      "replace": "$1\u00A1",
      "note": "Signs below and above a letter, and the reph, go before its spacer A1."
    },
    {
      "pattern": "(?\u003C!~)\\\u003E([stw%\u00F8no]\u002B)",
      "replace": "$1\u003E",
      "note": "Signs below a letter go before its spacer 3E."
    },
    {
      "pattern": "\\\u003E\uFDDB",
      "replace": "",
      "note": "Ya-sign after \u091F \u0920 \u0921 \u0922: in place of the spacer 3E (U\u002BFDDB marks it)."
    },
    {
      "pattern": "([Q\u0060\u00E7\u00E3\u00E6\u00A2\u0160\u2039\u0152\u00FB\u00FE\u0027\u2122\u00CB\u00CC\u0161\u203A\u2030\u0153\u00FF\u00AF\u00A9\u00AB\u00A8\u00AC\u0178\u00E4\u201E\u2020\u2021\u00BD\u02C6\u2022\u00B1]|~\\\u003E?)s",
      "replace": "$1l",
      "note": "u after \u0926 \u0939, their ligatures and the stacked ligatures: 6C."
    },
    {
      "pattern": "([Q\u0060\u00E7\u00E3\u00E6\u00A2\u0160\u2039\u0152\u00FB\u00FE\u0027\u2122\u00CB\u00CC\u0161\u203A\u2030\u0153\u00FF\u00AF\u00A9\u00AB\u00A8\u00AC\u0178\u00E4\u201E\u2020\u2021\u00BD\u02C6\u2022\u00B1]|~\\\u003E?)t",
      "replace": "$1m",
      "note": "uu there: 6D."
    },
    {
      "pattern": "([@U\u00C8\u00B1]\u00F8?)\u00A1r",
      "replace": "$1\u00A1\u201D",
      "note": "ii after \u0915 \u092B \u0915\u094D\u0915 \u0915\u094D\u0932 (and their ra-sign): 94."
    },
    {
      "pattern": "q(?=[\u0027@ABCDEFGHIJKLMNOPQRSTUVWXYZ\\\\\\^_\u0060abcdefghij\u201A\u0192\u201E\u2020\u2021\u02C6\u2030\u0160\u2039\u0152\u201C\u2022\u02DC\u2122\u0161\u203A\u0153\u0178\u00A2\u00A8\u00A9\u00AA\u00AB\u00AC\u00AE\u00AF\u00B0\u00B1\u00B2\u00B3\u00B4\u00B6\u00B8\u00BD\u00BE\u00C0\u00C3\u00C4\u00C5\u00C6\u00C7\u00C8\u00C9\u00CA\u00CB\u00CC\u00CD\u00CE\u00CF\u00D0\u00D1\u00DF\u00E0\u00E1\u00E2\u00E3\u00E4\u00E5\u00E6\u00E7\u00E8\u00E9\u00EC\u00ED\u00EE\u00EF\u00F0\u00F3\u00F4\u00FA\u00FB\u00FC\u00FD\u00FE\u00FF]|[\u00D7\u00D8\u00D9\u00DA\u00DB\u00DC\u00DE]|[ABCEGHINOPRSTVWXY\\\\\\^_bcef\u201A\u0192\u00C4\u00C5\u00C6\u00CA\u00CF\u00D0\u00D1\u00DF\u00F0\u00FA\u00FD])(?!Z)",
      "replace": "{",
      "note": "i-sign over a letter: 7B (71 over \u0930 and alone)."
    },
    {
      "pattern": "\\{(?=(?\u003E(?:(?:[\u00D7\u00D8\u00D9\u00DA\u00DB\u00DC\u00DE]|[ABCEGHINOPRSTVWXY\\\\\\^_bcef\u201A\u0192\u00C4\u00C5\u00C6\u00CA\u00CF\u00D0\u00D1\u00DF\u00F0\u00FA\u00FD](?![\u0022p]))|.o\\\u003E?)\u002B)(?![JK])|[JKLM]\u00F7)",
      "replace": "[",
      "note": "i-sign over a conjunct (not one ending in \u091F \u0920) or over \u091F \u0920 \u0921 \u0922 with the ya-sign: the long 5B."
    },
    {
      "pattern": "([r\u201Duv])z",
      "replace": "$1\u00EB",
      "note": "Anusvara after ii, e, ai: EB."
    },
    {
      "pattern": "[z\u00EB]\u00EA",
      "replace": "|",
      "note": "Anusvara \u002B reph: one glyph."
    },
    {
      "pattern": "[\uFDD1\uFDDB]",
      "replace": "",
      "note": "U\u002BFDD1 in a pair keeps the rules above off a spelling the composer writes its own way; U\u002BFDDB is spent above. Neither is text."
    }
  ]
