{
  "$comment": "Unicode Devanagari -> Kruti Dev 010/011 (legacy). Inverse of krutidev-to-unicode, derived from SIL's KrutiDev011.map. A pre-rule moves the i-matra back before its consonant cluster (Kruti Dev order); longest-match then maps conjuncts and half-forms before single letters. Long-tail conjuncts/reph are the client's to complete + verify.",
  "id": "unicode-to-krutidev",
  "name": "Unicode -> Kruti Dev 010",
  "sourceFontId": "mangal",
  "targetFontId": "krutidev",
  "sourceType": "unicode",
  "targetType": "legacy",
  "preRules": [
    {
      "pattern": "((?:[\\u0915-\\u0939]\\u093C?\\u094D)*[\\u0915-\\u0939]\\u093C?)ि",
      "replace": "ि$1",
      "note": "Move the i-matra from after the cluster (Unicode) to before it (Kruti Dev typing order)."
    }
  ],
