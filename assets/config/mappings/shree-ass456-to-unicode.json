  "postRules": [
    {
      "pattern": "\u09CD\u09CD",
      "replace": "\u09CD",
      "note": "A half letter read alone (\u09AE\u09CD B4) and a subscript (\u09CD\u09AE B5) after it are one conjunct: one hasanta."
    },
    {
      "pattern": "\u09C7((?:[\u0995-\u09B9\u09DC\u09DD\u09DF\u09F0\u09F1]\u09BC?(?:\u09CD\u200C|\u200C?\u09CD))*[\u0995-\u09B9\u09DC\u09DD\u09DF\u09F0\u09F1]\u09BC?)\u09BE",
      "replace": "$1\u09CB",
      "note": "\u09C7 ... \u09BE around a cluster is \u09CB."
    },
    {
      "pattern": "\u09C7((?:[\u0995-\u09B9\u09DC\u09DD\u09DF\u09F0\u09F1]\u09BC?(?:\u09CD\u200C|\u200C?\u09CD))*[\u0995-\u09B9\u09DC\u09DD\u09DF\u09F0\u09F1]\u09BC?)\u09D7",
      "replace": "$1\u09CC",
      "note": "\u09C7 ... \u09D7 around a cluster is \u09CC."
    },
    {
      "pattern": "\u09BF(\u0981?)((?:[\u0995-\u09B9\u09DC\u09DD\u09DF\u09F0\u09F1]\u09BC?(?:\u09CD\u200C|\u200C?\u09CD))*[\u0995-\u09B9\u09DC\u09DD\u09DF\u09F0\u09F1]\u09BC?)",
      "replace": "$2\u09BF$1",
      "note": "The i-sign (and the candrabindu of 7B) goes after its cluster (visual order -\u003E Unicode order)."
    },
    {
      "pattern": "([\u09C7\u09C8])((?:[\u0995-\u09B9\u09DC\u09DD\u09DF\u09F0\u09F1]\u09BC?(?:\u09CD\u200C|\u200C?\u09CD))*[\u0995-\u09B9\u09DC\u09DD\u09DF\u09F0\u09F1]\u09BC?)",
      "replace": "$2$1",
      "note": "The e/ai-signs go after their cluster."
    },
    {
      "pattern": "\u09EF(?=[\u0981\u0982\u0983])",
      "replace": "\u098C",
      "note": "\u098C is drawn with the digit \u09EF (39); with \u0981 \u0982 \u0983 on it, it is the vowel \u098C, not a digit."
    },
    {
      "pattern": "\u0985\u09BE",
      "replace": "\u0986",
      "note": "\u0985 \u002B \u09BE is written \u0986."
    },
    {
      "pattern": "\u09B0([\u09C1\u09C2\u09C3])\u09CD\u09AF",
      "replace": "\u09B0\u200C\u09CD\u09AF$1",
