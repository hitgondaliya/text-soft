<Window x:Class="FontSoftware.App.Views.DictionaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conversion dictionary" Width="660" Height="560" MinWidth="540" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBg}" FontFamily="{StaticResource UiFont}" Icon="/app.ico">
    <Grid Margin="24,20,24,20" TextElement.Foreground="{StaticResource Text}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Style="{StaticResource IconTile}" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,14,0">
                <TextBlock Text="&#xE82D;" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Center" />
            </Border>
            <StackPanel>
                <TextBlock Text="Conversion dictionary" Style="{StaticResource H2}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                           Text="Words the converter gets wrong, and what to write instead. Corrections are applied on the Unicode text, so one entry fixes the word in every layout. Whole words only." />
            </StackPanel>
        </DockPanel>

        <ContentControl Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Wrong (as converted)" Style="{StaticResource Label}" />
                    <TextBox x:Name="FromBox" FontFamily="Nirmala UI" FontSize="15" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="14" VerticalAlignment="Bottom"
                           Margin="12,0,12,12" Foreground="{StaticResource Muted}" />
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Correct" Style="{StaticResource Label}" />
                    <TextBox x:Name="ToBox" FontFamily="Nirmala UI" FontSize="15" />
                </StackPanel>
                <Button Grid.Column="3" Click="AddClick" VerticalAlignment="Bottom" Margin="12,0,0,0" AutomationProperties.Name="Add">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,7,0" />
                        <TextBlock Text="Add" />
                    </StackPanel>
                </Button>
            </Grid>
        </ContentControl>

        <ContentControl Grid.Row="2" Style="{StaticResource Card}" Padding="1">
            <ListView x:Name="List" BorderThickness="0" Background="Transparent" FontFamily="Nirmala UI" FontSize="14">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Wrong" Width="240" DisplayMemberBinding="{Binding From}" />
                        <GridViewColumn Header="Correct" Width="240" DisplayMemberBinding="{Binding To}" />
                        <GridViewColumn Header="Script" Width="100" DisplayMemberBinding="{Binding Language}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </ContentControl>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <Button Click="RemoveClick" Style="{StaticResource Secondary}" DockPanel.Dock="Left" AutomationProperties.Name="Remove selected">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,7,0" />
                    <TextBlock Text="Remove selected" />
                </StackPanel>
            </Button>
            <Button Content="Close" Click="CloseClick" DockPanel.Dock="Right" MinWidth="96" />
            <TextBlock x:Name="Count" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0" />
        </DockPanel>
    </Grid>
</Window>
