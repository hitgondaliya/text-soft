<Window x:Class="FontSoftware.App.Views.DictionaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conversion dictionary" Width="620" Height="520" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBg}" FontFamily="{StaticResource UiFont}" Icon="/app.ico">
    <Grid Margin="22" TextElement.Foreground="{StaticResource Text}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Hint}" Margin="0,0,0,14"
                   Text="Words the converter gets wrong, and what to write instead. Corrections are applied on the Unicode text, so one entry fixes the word in every layout. Whole words only." />

        <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="10" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="WRONG (AS CONVERTED)" Style="{StaticResource Label}" />
                    <TextBox x:Name="FromBox" FontFamily="Nirmala UI" FontSize="15" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="→" FontSize="18" VerticalAlignment="Bottom" Margin="10,0,10,8" Foreground="{StaticResource Muted}" />
                <StackPanel Grid.Column="2">
                    <TextBlock Text="CORRECT" Style="{StaticResource Label}" />
                    <TextBox x:Name="ToBox" FontFamily="Nirmala UI" FontSize="15" />
                </StackPanel>
                <Button Grid.Column="3" Content="Add" Click="AddClick" VerticalAlignment="Bottom" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource Surface}" CornerRadius="10" BorderBrush="{StaticResource Border}" BorderThickness="1">
            <ListView x:Name="List" BorderThickness="0" Background="Transparent" FontFamily="Nirmala UI" FontSize="14">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Wrong" Width="230" DisplayMemberBinding="{Binding From}" />
                        <GridViewColumn Header="Correct" Width="230" DisplayMemberBinding="{Binding To}" />
                        <GridViewColumn Header="Script" Width="90" DisplayMemberBinding="{Binding Language}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button Content="Remove selected" Click="RemoveClick" Style="{StaticResource Secondary}" DockPanel.Dock="Left" />
            <Button Content="Close" Click="CloseClick" DockPanel.Dock="Right" />
            <TextBlock x:Name="Count" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0" />
        </DockPanel>
    </Grid>
</Window>
