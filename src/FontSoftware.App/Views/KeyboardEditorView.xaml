<UserControl x:Class="FontSoftware.App.Views.KeyboardEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:FontSoftware.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Which language, which keyboard to start from, and what to call it -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="14" Padding="18,14">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,16,8" MinWidth="170">
                        <TextBlock Text="LANGUAGE" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                  DisplayMemberPath="Name" MinWidth="170" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8" MinWidth="200">
                        <TextBlock Text="START FROM" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding SourceLayouts}" SelectedItem="{Binding SelectedSource}"
                                  DisplayMemberPath="Name" MinWidth="200" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8" MinWidth="200">
                        <TextBlock Text="KEYBOARD NAME" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MinWidth="200" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <Button Content="New" Command="{Binding NewCommand}" MinWidth="76" Margin="0,0,8,0" Style="{StaticResource Secondary}" />
                        <Button Content="Open" Command="{Binding OpenCommand}" MinWidth="76" Margin="0,0,8,0" Style="{StaticResource Secondary}"
                                ToolTip="Load the selected keyboard so it can be modified" />
                        <Button Content="Save" Command="{Binding SaveCommand}" MinWidth="86" Margin="0,0,8,0" />
                        <Button Content="Import Shree-Lipi file…" Click="ImportClick" MinWidth="150" Style="{StaticResource Secondary}"
                                ToolTip="Bring in a keyboard made in Shree-Lipi's Keyboard Generator (.GUJ, .DEV, .SAN, .PUN, .BAN, .ASS, .ORI, .TAM, .TEL, .KAN, .MAL)" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- The three layers a vendor keyboard has -->
        <WrapPanel Grid.Row="1" Margin="0,14,0,10">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="10" Padding="10,5" Margin="0,0,14,6" VerticalAlignment="Center">
                <WrapPanel>
                    <TextBlock Text="Layer" FontSize="12" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <RadioButton Content="Normal" GroupName="EditLayer" IsChecked="{Binding ShowNormalLayer}"
                                 VerticalAlignment="Center" Margin="0,0,12,0" />
                    <RadioButton Content="Shift" GroupName="EditLayer" IsChecked="{Binding ShowShiftLayer}"
                                 VerticalAlignment="Center" Margin="0,0,12,0" />
                    <RadioButton Content="Ctrl+Space" GroupName="EditLayer" IsChecked="{Binding ShowEscapeLayer}"
                                 VerticalAlignment="Center" />
                </WrapPanel>
            </Border>
            <TextBlock Text="{Binding SelectedKeyLabel}" VerticalAlignment="Center" FontWeight="SemiBold"
                       Margin="0,0,14,6" />
            <TextBlock Text="{Binding ConjunctCountText}" VerticalAlignment="Center" Style="{StaticResource Hint}"
                       Margin="0,0,0,6" />
        </WrapPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- The keyboard: click a key to assign it -->
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="14" Padding="16">
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="1120" HorizontalAlignment="Left">
                        <ItemsControl ItemsSource="{Binding KeyboardRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="56" Height="56" Margin="4" CornerRadius="10"
                                                        Cursor="Hand" Tag="{Binding}"
                                                        MouseLeftButtonUp="KeyClicked"
                                                        ToolTip="Click to assign key">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Label}" FontSize="10"
                                                                   FontFamily="{StaticResource UiFont}"
                                                                   Foreground="{StaticResource Faint}"
                                                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                   Margin="7,5,0,0" />
                                                        <TextBlock Text="{Binding Display}" FontSize="22"
                                                                   Foreground="{StaticResource Text}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource AppBg}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMapped}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource PrimaryLight}" />
                                                                    <Setter Property="BorderBrush" Value="#F3C09B" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource Primary}" />
                                                                    <Setter Property="BorderThickness" Value="2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Viewbox>
                </Border>

                <!-- The character palette, and the conjunct being built -->
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,14,0,0">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,10">
                            <TextBlock Text="CHARACTERS" Style="{StaticResource Label}" VerticalAlignment="Center"
                                       Margin="0,0,14,6" />
                            <ToggleButton Content="Special" IsChecked="{Binding ShowSpecials}" MinWidth="86"
                                          Margin="0,0,8,6" ToolTip="Punctuation and signs" />
                            <Button Content="Form Conjunct" Command="{Binding FormConjunctCommand}" MinWidth="120"
                                    Margin="0,0,8,6" ToolTip="Build a character of up to four parts" />
                            <Button Content="Link" Command="{Binding LinkCommand}" MinWidth="64" Margin="0,0,8,6" Style="{StaticResource Secondary}"
                                    ToolTip="Join the next character to the one before it" />
                            <Button Content="Half" Command="{Binding HalfCommand}" MinWidth="64" Margin="0,0,8,6" Style="{StaticResource Secondary}"
                                    ToolTip="Makes previous character half" />
                            <Button Content="BS" Command="{Binding BackspaceCommand}" MinWidth="52" Margin="0,0,8,6" Style="{StaticResource Secondary}"
                                    ToolTip="Delete the conjunct" />
                            <Button Content="Blank" Command="{Binding BlankCommand}" MinWidth="70" Margin="0,0,8,6" Style="{StaticResource Secondary}"
                                    ToolTip="This key types nothing" />
                        </WrapPanel>

                        <Border Background="{StaticResource PrimaryLight}" CornerRadius="10" Padding="12,8"
                                Margin="0,0,0,10"
                                Visibility="{Binding ConjunctMode, Converter={StaticResource BoolToVis}}">
                            <WrapPanel>
                                <TextBlock Text="Conjunct:" VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{StaticResource PrimaryDeep}" />
                                <TextBlock Text="{Binding Conjunct}" FontSize="22" VerticalAlignment="Center"
                                           Margin="0,0,16,0" MinWidth="60" />
                                <Button Content="OK" Command="{Binding ApplyConjunctCommand}" MinWidth="64"
                                        Margin="0,0,8,0"  />
                                <Button Content="Cancel" Command="{Binding CancelConjunctCommand}" MinWidth="70" Style="{StaticResource Secondary}" />
                            </WrapPanel>
                        </Border>

                        <ItemsControl x:Name="PaletteItems" ItemsSource="{Binding Palette}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" FontSize="19" MinWidth="46" Height="44" Margin="3" Cursor="Hand"
                                            Click="CharacterClicked" Tag="{Binding}" Style="{StaticResource Secondary}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Specials}"
                                      Visibility="{Binding ShowSpecials, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" FontSize="17" MinWidth="46" Height="44" Margin="3" Cursor="Hand"
                                            Click="CharacterClicked" Tag="{Binding}" Style="{StaticResource Secondary}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Style="{StaticResource Hint}" Margin="2,12,0,0"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
