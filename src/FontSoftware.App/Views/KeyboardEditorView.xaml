<UserControl x:Class="FontSoftware.App.Views.KeyboardEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:FontSoftware.App.Controls">
    <UserControl.Resources>
        <Style x:Key="BtnIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource Secondary}">
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,0,8,6" />
        </Style>
        <!-- A character in the palette: a small keycap you click to assign. -->
        <Style x:Key="PaletteKey" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <!-- The character through a template, sized from the button: a bare string
                 would take the app-wide 13px text style instead. -->
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="10" Background="{StaticResource KeyFace}" BorderBrush="#DDD8D1"
                                BorderThickness="1,1,1,2" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource KeyFaceMapped}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Primary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource PrimaryLight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Which language, which keyboard to start from, and what to call it -->
        <ContentControl Grid.Row="0" Style="{StaticResource Card}" Padding="20,16,20,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,8">
                        <TextBlock Text="Language" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                  DisplayMemberPath="Name" AutomationProperties.Name="Keyboard language" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,8">
                        <TextBlock Text="Start from" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding SourceLayouts}" SelectedItem="{Binding SelectedSource}"
                                  DisplayMemberPath="Name" AutomationProperties.Name="Start from" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="Keyboard name" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Keyboard name" />
                    </StackPanel>
                </Grid>
                <WrapPanel Margin="0,6,0,0">
                    <Button Command="{Binding NewCommand}" Style="{StaticResource ToolButton}" AutomationProperties.Name="New">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource BtnIcon}" />
                            <TextBlock Text="New" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenCommand}" Style="{StaticResource ToolButton}" AutomationProperties.Name="Open"
                            ToolTip="Load the selected keyboard so it can be modified">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" Style="{StaticResource BtnIcon}" />
                            <TextBlock Text="Open" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveCommand}" Padding="16,8" FontSize="12.5" Margin="0,0,8,6" AutomationProperties.Name="Save">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource BtnIcon}" />
                            <TextBlock Text="Save" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="24" Background="{StaticResource Border}" Margin="4,0,12,6" VerticalAlignment="Center" />
                    <Button Click="ImportClick" Style="{StaticResource ToolButton}" AutomationProperties.Name="Import Shree-Lipi file"
                            ToolTip="Bring in a keyboard made in Shree-Lipi's Keyboard Generator (.GUJ, .DEV, .SAN, .PUN, .BAN, .ASS, .ORI, .TAM, .TEL, .KAN, .MAL)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B5;" Style="{StaticResource BtnIcon}" />
                            <TextBlock Text="Import Shree-Lipi file…" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </ContentControl>

        <!-- The three layers a vendor keyboard has -->
        <WrapPanel Grid.Row="1" Margin="0,14,0,10">
            <Border Style="{StaticResource SegmentBar}" Margin="0,0,16,6">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" Content="Normal" GroupName="EditLayer" IsChecked="{Binding ShowNormalLayer}" />
                    <RadioButton Style="{StaticResource Segment}" Content="Shift" GroupName="EditLayer" IsChecked="{Binding ShowShiftLayer}" />
                    <RadioButton Style="{StaticResource Segment}" Content="Ctrl+Space" GroupName="EditLayer" IsChecked="{Binding ShowEscapeLayer}" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,6">
                <TextBlock Text="&#xE7C9;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Primary}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding SelectedKeyLabel}" VerticalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Text="{Binding ConjunctCountText}" VerticalAlignment="Center" Style="{StaticResource Hint}" Margin="0,0,0,6" />
        </WrapPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel>
                <!-- The keyboard: click a key to assign it -->
                <ContentControl Style="{StaticResource Card}" Padding="16">
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="1180" HorizontalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding KeyboardRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Width="56" Height="58" Margin="4" Cursor="Hand" Tag="{Binding}"
                                                      MouseLeftButtonUp="KeyClicked" ToolTip="Click to assign key" Background="Transparent">
                                                    <Border x:Name="cap" CornerRadius="11" Background="#F1EFEC"
                                                            BorderBrush="#E6E2DD" BorderThickness="1" SnapsToDevicePixels="True" />
                                                    <TextBlock x:Name="lbl" Text="{Binding Label}" FontSize="10"
                                                               FontFamily="{StaticResource UiFont}" FontWeight="SemiBold"
                                                               Foreground="#B4B9C2"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top"
                                                               Margin="8,5,0,0" />
                                                    <TextBlock Text="{Binding Display}" FontSize="23"
                                                               Foreground="{StaticResource Text}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Margin="0,4,0,0" />
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsMapped}" Value="True">
                                                        <Setter TargetName="cap" Property="Background" Value="{StaticResource KeyFace}" />
                                                        <Setter TargetName="cap" Property="BorderBrush" Value="#DDD8D1" />
                                                        <Setter TargetName="cap" Property="BorderThickness" Value="1,1,1,2.5" />
                                                        <Setter TargetName="lbl" Property="Foreground" Value="{StaticResource Primary}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="cap" Property="Background" Value="{StaticResource PrimaryLight}" />
                                                        <Setter TargetName="cap" Property="BorderBrush" Value="{StaticResource Primary}" />
                                                        <Setter TargetName="cap" Property="BorderThickness" Value="2" />
                                                        <Setter TargetName="lbl" Property="Foreground" Value="{StaticResource PrimaryDeep}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Viewbox>
                </ContentControl>

                <!-- The character palette, and the conjunct being built -->
                <ContentControl Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,2">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="Characters" Style="{StaticResource H3}" VerticalAlignment="Center" Margin="2,0,16,6" />
                            <ToggleButton Content="Special" IsChecked="{Binding ShowSpecials}" Style="{StaticResource Chip}"
                                          Padding="13,8" FontSize="12.5" Margin="0,0,8,6" ToolTip="Punctuation and signs" />
                            <Button Command="{Binding FormConjunctCommand}" Padding="14,8" FontSize="12.5" Margin="0,0,8,6"
                                    AutomationProperties.Name="Form Conjunct" ToolTip="Build a character of up to four parts">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71B;" Style="{StaticResource BtnIcon}" />
                                    <TextBlock Text="Form Conjunct" />
                                </StackPanel>
                            </Button>
                            <Button Content="Link" Command="{Binding LinkCommand}" Style="{StaticResource ToolButton}"
                                    ToolTip="Join the next character to the one before it" />
                            <Button Content="Half" Command="{Binding HalfCommand}" Style="{StaticResource ToolButton}"
                                    ToolTip="Makes previous character half" />
                            <Button Command="{Binding BackspaceCommand}" Style="{StaticResource ToolButton}" AutomationProperties.Name="BS"
                                    ToolTip="Delete the conjunct">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE750;" Style="{StaticResource BtnIcon}" />
                                    <TextBlock Text="BS" />
                                </StackPanel>
                            </Button>
                            <Button Content="Blank" Command="{Binding BlankCommand}" Style="{StaticResource ToolButton}"
                                    ToolTip="This key types nothing" />
                        </WrapPanel>

                        <Border Background="{StaticResource PrimarySoft}" BorderBrush="{StaticResource PrimaryLight}" BorderThickness="1"
                                CornerRadius="12" Padding="14,10" Margin="0,0,0,12"
                                Visibility="{Binding ConjunctMode, Converter={StaticResource BoolToVis}}">
                            <WrapPanel>
                                <TextBlock Text="Conjunct" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryDeep}" />
                                <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="12,2" MinWidth="80" Margin="0,0,16,0"
                                        BorderBrush="{StaticResource PrimaryEdge}" BorderThickness="1">
                                    <TextBlock Text="{Binding Conjunct}" FontSize="22" VerticalAlignment="Center" />
                                </Border>
                                <Button Content="OK" Command="{Binding ApplyConjunctCommand}" MinWidth="70" Padding="14,8" Margin="0,0,8,0" />
                                <Button Content="Cancel" Command="{Binding CancelConjunctCommand}" MinWidth="76" Padding="14,8" Style="{StaticResource Secondary}" />
                            </WrapPanel>
                        </Border>

                        <ItemsControl x:Name="PaletteItems" ItemsSource="{Binding Palette}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" FontSize="19" Click="CharacterClicked" Tag="{Binding}" Style="{StaticResource PaletteKey}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Specials}"
                                      Visibility="{Binding ShowSpecials, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" FontSize="17" Click="CharacterClicked" Tag="{Binding}" Style="{StaticResource PaletteKey}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="4,12,0,0">
            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Muted}"
                       DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Top" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</UserControl>
