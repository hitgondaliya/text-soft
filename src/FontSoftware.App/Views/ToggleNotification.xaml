<Window x:Class="FontSoftware.App.Views.ToggleNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False" IsHitTestVisible="False">
    <Border Background="#EE1E1E1E" CornerRadius="8" Padding="18,12">
        <StackPanel>
            <TextBlock x:Name="StatusText" Foreground="White" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="ProfileText" Foreground="#CCFFFFFF" FontSize="13" Margin="0,4,0,0" />
        </StackPanel>
    </Border>
</Window>
