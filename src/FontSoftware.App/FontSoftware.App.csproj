<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- WinForms is enabled only for the system-tray icon (NotifyIcon); the UI is WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FontSoftware.App</RootNamespace>
    <AssemblyName>TextSoft</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- WPF drives DPI via the manifest (correct for this WPF-only UI); silence the
         WinForms analyzer that wants DPI configured through its own API instead. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- Reported to the licence server as appVersion; bump per release. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so the window title bar can use it too. -->
    <Resource Include="app.ico" />
    <!-- TextSoft brand logo (lives at the repo root), shown in the sidebar. -->
    <Resource Include="..\..\logo.png" Link="logo.png" />
    <!-- Country list + one flag PNG per country for the registration form
         (Windows renders emoji flags as letters, so bitmaps are embedded). -->
    <Resource Include="Assets\countries.json" />
    <!-- The TS mark cut out of logo.png: brand colours, and light strokes for the dark sidebar. -->
    <Resource Include="Assets\logo-mark.png" />
    <Resource Include="Assets\logo-mark-light.png" />
    <Resource Include="Assets\flags\*.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mobile-number validation per country (same rules as the server's libphonenumber-js). -->
    <PackageReference Include="libphonenumber-csharp" Version="9.0.39" />
    <!-- .docx conversion (Converter nxt "Files" mode). -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <!-- WinForms is used only for the tray icon, via an explicit alias in code.
       Drop its implicit global usings so 'Application', 'MessageBox', etc. stay
       unambiguously WPF everywhere else. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FontSoftware.Core\FontSoftware.Core.csproj" />
    <ProjectReference Include="..\FontSoftware.Engine\FontSoftware.Engine.csproj" />
    <ProjectReference Include="..\FontSoftware.Licensing\FontSoftware.Licensing.csproj" />
  </ItemGroup>

  <!-- Ship the config next to the app; client replaces with real assets.
       Includes JSON catalog/layouts/mappings and any bundled font files. -->
  <ItemGroup>
    <Content Include="..\..\assets\config\**\*.json;..\..\assets\config\**\*.ttf;..\..\assets\config\**\*.otf" Link="config\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
