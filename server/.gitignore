# deps
/node_modules
/.pnp
.pnp.js

# next
/.next/
/out/
next-env.d.ts

# production
/build

# env — SECRETS. Never commit. Ed25519 private key lives here.
.env
.env.local
.env*.local
# Next.js reads .env.production before .env, so it must never exist on the server.
# The template is .env.production.example.
.env.production

# keys (any stray PEM/key material)
*.pem
/keys/

# misc
.DS_Store
*.log
npm-debug.log*
.next-dev/
# Check builds (NEXT_DIST_DIR=.next-check npx next build) — tsconfig already lists it.
.next-check/
