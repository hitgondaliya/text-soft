# ---- TextSoft license server config (template) ----
# Copy to .env.local for local dev, or set these on the VPS (chmod 600 .env).
# NEVER commit real values. LICENSE_PRIVATE_KEY is the crown jewel.

# Port the panel listens on. nginx proxies to 127.0.0.1:<PORT>; `npm run dev:db` uses it too.
PORT=3100

# MongoDB connection string.
#   Local:  mongodb://127.0.0.1:27017
#   Atlas:  mongodb+srv://user:pass@cluster.xxxx.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=textsoft_licenses

# Ed25519 signing keypair, base64 of the PEM file. Generate with: npm run genkeys
# The PRIVATE key signs license tokens and must never leave the server.
LICENSE_PRIVATE_KEY=
# PUBLIC key — also embedded in the WPF client; kept here only for reference/tools.
LICENSE_PUBLIC_KEY=

# Signs the admin session cookie (any long random string). openssl rand -base64 32
COOKIE_SECRET=

# Encrypts the recoverable copy of every licence key and the SMTP password saved in
# the panel. Generate once with: openssl rand -base64 32 — then NEVER change or lose it
# (keys sealed with it could no longer be shown; they would still activate).
# If left empty, a key derived from COOKIE_SECRET is used instead.
KEY_VAULT_SECRET=

# Bootstrap admin, used by: npm run seed-admin
ADMIN_EMAIL=admin@textsoft.local
ADMIN_PASSWORD=change-me-now

# Public URL of the panel (logo in emails).
APP_BASE_URL=http://localhost:3100

# Outgoing mail fallback. An owner can set SMTP in the panel (Settings → Email);
# those settings override these lines. Gmail: an app password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# MAIL_FROM=TextSoft <you@gmail.com>    (default: TextSoft <SMTP_USER>)
# MAIL_REPLY_TO=you@gmail.com           (default: SMTP_USER)
# Settings → Email refuses hosts on this machine's own network unless the port is a
# mail port (25, 465, 587, 2525). Set to 1 only for an unusual internal relay.
# SMTP_ALLOW_PRIVATE_HOSTS=1

# Offline grace + heartbeat hints returned to the client (server is source of truth).
OFFLINE_GRACE_DAYS=5
HEARTBEAT_HOURS=24
