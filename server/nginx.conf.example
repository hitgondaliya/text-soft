# /etc/nginx/sites-available/textsoft-admin  →  ln -s into sites-enabled, nginx -t, reload.
# Then: sudo certbot --nginx -d admin.text-soft.com   (adds the HTTPS block + redirect)
#
# The panel listens on 127.0.0.1:3100 (PORT in .env; deploy.sh and ecosystem.config.cjs
# default to 3100). Keep proxy_pass in step with it — after certbot, change it in the
# HTTPS (listen 443) block too.
server {
    listen 80;
    server_name admin.text-soft.com;

    client_max_body_size 2m;

    location / {
        proxy_pass         http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        # The app reads the client IP from X-Real-IP (rate limits, attempt log).
        # Overwrite both headers with the real peer; never pass on a client-sent value.
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $remote_addr;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
