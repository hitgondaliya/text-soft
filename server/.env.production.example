# ---- TextSoft licence panel — PRODUCTION env template ----
# Copy to .env on the VPS:  cp .env.production.example .env  (deploy.sh refuses to run
# without .env). Never commit .env. Do NOT name a copy .env.production: Next.js reads
# that file before .env, so its blank lines would override your real secrets.

# MongoDB on the same VPS (default port, no auth). Add user:pass@ if you enable auth.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=textsoft_licenses

# Ed25519 keypair for licence tokens — from `npm run genkeys`. The PUBLIC key's raw
# form is compiled into the Windows app; if you regenerate, rebuild the app too.
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=

# Random 32+ bytes; signs the admin session cookie.
COOKIE_SECRET=

# Encrypts the recoverable copy of every licence key and the SMTP password saved in the
# panel. Generate once: openssl rand -base64 32 — then never change or lose it.
# Empty = derived from COOKIE_SECRET (then never change COOKIE_SECRET either).
KEY_VAULT_SECRET=

# Bootstrap owner account (created/updated by deploy.sh). Change the password
# from Team → Password after first sign-in, or here and redeploy.
ADMIN_EMAIL=textsoft.office@gmail.com
ADMIN_PASSWORD=

# Public URL of the panel (logo in emails, links).
APP_BASE_URL=https://admin.text-soft.com

# Outgoing mail — Gmail with an app password (Google Account → Security → App passwords).
# An owner can also set SMTP in the panel (Settings → Email); that overrides these lines.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=textsoft.office@gmail.com
SMTP_PASS=
MAIL_FROM=TextSoft <textsoft.office@gmail.com>
MAIL_REPLY_TO=textsoft.office@gmail.com

# Licence behaviour
OFFLINE_GRACE_DAYS=5
HEARTBEAT_HOURS=24

# Port the panel listens on; nginx proxies admin.text-soft.com to 127.0.0.1:<PORT>.
PORT=3100
