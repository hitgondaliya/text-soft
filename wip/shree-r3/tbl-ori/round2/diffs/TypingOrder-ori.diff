     /// <summary>
+    /// A keyboard that types each consonant in its virama form (Shree's Phonetic: "k" is କ୍, "d" is ଦ୍) shows on ka what a
+    /// vowel key does after one: "ke" is କେ, "ka" is କ (the inherent a), "kee" is କୀ, "kai" is କୈ. The chart prints those
+    /// runs for ka alone; Shree's composer joins the vowel to every consonant and cluster the same way, so the join is
+    /// learned here as "a virama, then what those vowel keys type there" -> "the sign in the virama's place", and applied to
+    /// the whole word (<see cref="Compose"/>). What the vowel keys type after the consonant is what they type after any
+    /// other: their own run ("ee" is ଈ, "ai" is ଐ) or their keys one after the other ("aa" is ା ା). Only a keyboard whose
+    /// runs join an independent vowel this way is a phonetic one: a typewriter's half letter is struck before ા, not ଏ.
+    /// </summary>
+    private void LearnAfterVirama(KeyboardLayout layout, Dictionary<char, string> alone)
+    {
+        var joins = new Dictionary<string, string>(StringComparer.Ordinal);
+        var clash = new HashSet<string>(StringComparer.Ordinal);
+        bool vowelTaught = false, signTaught = false;
+        foreach (var s in layout.Sequences)
+        {
+            if (s.Keys.Length is < 2 or > 3 || string.IsNullOrEmpty(s.To)) continue;
+            if (s.Keys.IndexOf(EscapeLayer.Mark) >= 0 || s.Keys.IndexOf(EscapeLayer.SymbolMark) >= 0) continue;
+            if (!alone.TryGetValue(s.Keys[0], out var first) || first.Length != 2 || !IsConsonantChar(first[0]) || Offset(first[1]) != 0x4D)
+                continue;
+            if (s.To[0] != first[0]) continue;
+            string sign = s.To[1..];
+            if (!sign.All(IsSignChar)) continue;                       // "kka" is a cluster, not a vowel on ka
+            string tail = s.Keys[1..];
+            string? typed = layout.MatchSequence(tail);
+            if (typed is null)
+            {
+                var sb = new StringBuilder();
+                foreach (char k in tail)
+                {
+                    if (!alone.TryGetValue(k, out var t)) { sb = null; break; }
+                    sb.Append(t);
+                }
+                typed = sb?.ToString();
+            }
+            if (string.IsNullOrEmpty(typed) || !typed.All(c => IsSignChar(c) || IsVowelChar(c))) continue;
+            string from = first[1] + typed;
+            if (joins.TryGetValue(from, out var had) && had != sign) clash.Add(from);
+            joins[from] = sign;
+            if (typed.Any(IsVowelChar) && sign.Length > 0) vowelTaught = true;
+            if (typed.Length == 1 && sign == typed && Offset(typed[0]) is >= 0x3E and <= 0x4C) signTaught = true;
+        }
