  "postRules": [
    {
      "pattern": "\uFDD3(?=\uFDD2|(?!\u0B15\u0B4D\u0B37)[\u0B15\u0B16\u0B17\u0B18\u0B1A\u0B1B\u0B1C\u0B1D\u0B1F\u0B20\u0B21\u0B22\u0B23\u0B25\u0B26\u0B27\u0B28\u0B2A\u0B2B\u0B2C\u0B2D\u0B2E\u0B2F\u0B30\u0B32\u0B33\u0B38\u0B5F\u0B71])",
      "replace": "\u200C",
      "note": "The visible virama FA before a letter with a subjoined form, or before the next syllable\u0027s e-sign, is \u0B4D \u002B ZWNJ (\u0B15\u0B4D\u200C\u0B15 = 4C FF FA 4C FF): plain \u0B15\u0B4D\u0B15 is the ligature 4D, which the bytes do not show. Not before the ligature \u0B15\u0B4D\u0B37 E4: C \u002B virama \u002B \u0B15\u0B4D\u0B37 is C FA E4 (\u0B16\u0B4D\u0B15\u0B4D\u0B37 = 51 FA E4)."
    },
    {
      "pattern": "\uFDD3",
      "replace": "",
      "note": "Elsewhere FA is the virama alone (\u0B15\u0B4D\u0B24 = 4C FF FA 86 FF, \u0B15\u0B4D at the end of a word = 4C FF FA)."
    },
    {
      "pattern": "([\u0B3E-\u0B44\u0B56\u0B57\u0B62\u0B63]\u002B)(\u0B4D[\u0B30\u0B5F\u0B2C])",
      "replace": "$2$1",
      "note": "A sign the composer wrote before a phala (struck before the ra-, ya- or ba-phala code: \u0B15\u0B43 then the ra-phala = 4C FF F5 26 F7) belongs after it: \u0B15\u0B4D\u0B30\u0B43."
    },
    {
      "pattern": "\uFDD2(\uFDD0?)((?:[\u0B15-\u0B28\u0B2A-\u0B30\u0B32\u0B33\u0B36-\u0B39\u0B5C\u0B5D\u0B5F\u0B71]\u0B3C?\u0B4D\u200D?)*[\u0B15-\u0B28\u0B2A-\u0B30\u0B32\u0B33\u0B36-\u0B39\u0B5C\u0B5D\u0B5F\u0B71]\u0B3C?|[\u0B05-\u0B0C\u0B0F\u0B10\u0B13\u0B14\u0B60\u0B61])",
      "replace": "$1$2\u0B47",
      "note": "The e-sign 7B goes after its cluster (visual order -\u003E Unicode order; a ZWJ half form is part of it: \u0B24\u0B4D\u200D\u0B28\u0B47 = 7B 86 FF A7), or after the vowel it was struck on (\u0B05\u0B47 = 7B 41); a reph written between them (7B F6 C) stays in front."
    },
    {
      "pattern": "\u0B47(\uFDD0?)\u0B56",
      "replace": "\u0B48$1",
      "note": "\u0B47 \u002B \u0B56 is \u0B48 (7B C F0; a reph the composer wrote between them, 7B C F6 F0, goes after both)."
    },
    {
      "pattern": "\u0B47(\uFDD0?)\u0B3E",
      "replace": "\u0B4B$1",
      "note": "\u0B47 \u002B \u0B3E is \u0B4B (7B C E6)."
    },
    {
      "pattern": "\u0B47(\uFDD0?)\u0B57",
      "replace": "\u0B4C$1",
      "note": "\u0B47 \u002B \u0B57 is \u0B4C (7B C F2)."
    },
    {
      "pattern": "([\u0B15-\u0B28\u0B2A-\u0B30\u0B32\u0B33\u0B36-\u0B39\u0B5C\u0B5D\u0B5F\u0B71]\u0B3C?(?:\u0B4D[\u0B15-\u0B28\u0B2A-\u0B30\u0B32\u0B33\u0B36-\u0B39\u0B5C\u0B5D\u0B5F\u0B71]\u0B3C?)*|[\u0B05-\u0B0C\u0B0F\u0B10\u0B13\u0B14\u0B60\u0B61])([\u0B3E-\u0B44\u0B47\u0B48\u0B4B\u0B4C\u0B56\u0B57\u0B62\u0B63\u0B4D]*)([\u0B01-\u0B03]*)\uFDD0",
      "replace": "\u0B30\u0B4D$1$2$3",
      "note": "The reph F6 after a syllable is \u0B30\u0B4D in front of its cluster (\u0B30\u0B4D\u0B15\u0B3E = 4C FF E6 F6; written after \u0B02 \u0B01 \u0B03 too, as the composer accepts: 4C FF F3 F6), or of the vowel it stands on (\u0B30\u0B4D\u0B05 = 41 F6)."
    },
    {
      "pattern": "\uFDD0",
      "replace": "\u0B30\u0B4D",
      "note": "A reph with no syllable before it (the lone reph key, or one struck before its letter) is \u0B30\u0B4D."
    },
    {
      "pattern": "\uFDD2",
      "replace": "\u0B47",
      "note": "An e-sign with no letter after it is \u0B47."
    },
    {
      "pattern": "\u0B05\u0B3E",
      "replace": "\u0B06",
      "note": "\u0B05 \u002B \u0B3E is \u0B06 (41 E6), as the Unicode composer writes it."
    },
    {
      "pattern": "\uFDD1",
      "replace": "",
      "note": "U\u002BFDD1 is not text."
    }
  ]
