    {
      "pattern": "\\}",
      "replace": "o\u00A9",
      "note": "7D: the sign 6F with a reph - two pieces, so the reph can move."
    },
    {
      "pattern": "\u00A3",
      "replace": "\u00A1\u00A9",
      "note": "A3: the sign A1 with a reph - two pieces, so the reph can move."
    },
    {
