  "postRules": [
    {
      "pattern": "([\u0A95-\u0AB9])((?:\u0ACD[\u0AAF\u0AB0\u0AB5])?[\u0A81-\u0A83\u0ABE-\u0ACC]*)\u0ABC",
      "replace": "$1\u0ABC$2",
      "note": "Nukta: right after its letter. The bytes have it before the glyph it sits under, and the pre rules after that glyph - which can be a letter with its vowel sign (\u0A9C\u0ABE C5, \u0AA3\u0AC1 CF) or with the ra-, ya- or va-sign (\u0A95\u0ACD\u0AB0 BE): \u0A9C\u0ABC\u0ABE and \u0A95\u0ABC\u0ACD\u0AB0, not \u0A9C\u0ABE\u0ABC and \u0A95\u0ACD\u0AB0\u0ABC."
    },
