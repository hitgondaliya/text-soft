      "note": "AF: the sign 84 with a reph - two pieces, so the reph can move."
    },
    {
      "pattern": "\u2026",
      "replace": "]\u00AE",
      "note": "85: the sign 5D with a reph - two pieces, so the reph can move."
    },
    {
      "pattern": "\u00A4",
      "replace": "\u00A2\u00AE",
      "note": "A4: the sign A2 with a reph - two pieces, so the reph can move."
    },
    {
