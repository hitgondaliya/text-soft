  "postRules": [
    {
      "pattern": "\uFDDD(?=[\u0A30\u0A39\u0A35\u0A2F])",
      "replace": "\u200C",
      "note": "The visible halant B5 before \u0A30 \u0A39 \u0A35 \u0A2F is \u0A4D \u002B ZWNJ (\u0A15\u0A4D\u200C\u0A30 = 48 B5 63): plain \u0A15\u0A4D\u0A30 is the subjoined form (6E), which the bytes do not show."
    },
    {
      "pattern": "\uFDDD",
      "replace": "",
      "note": "Elsewhere the halant B5 is the virama alone (\u0A15\u0A4D\u0A24 = 48 B5 57, \u0A15\u0A4D at the end of a word = 48 B5)."
    },
    {
      "pattern": "\u0A3F((?:\u0A4D[\u0A30\u0A39\u0A35\u0A2F])\u002B)",
      "replace": "$1\u0A3F",
      "note": "An i-sign the composer wrote between a letter and its subjoined form (48 71 62, \u0A15\u0A4D\u0A2F typed with the i-sign after the letter) belongs to the whole cluster: after the subjoined form."
    },
    {
      "pattern": "\u0A3F((?:[\u0A15-\u0A28\u0A2A-\u0A30\u0A32\u0A33\u0A35\u0A36\u0A38\u0A39\u0A59-\u0A5C\u0A5E]\u0A3C?\u0A4D[\u200C\u200D]?)*[\u0A15-\u0A28\u0A2A-\u0A30\u0A32\u0A33\u0A35\u0A36\u0A38\u0A39\u0A59-\u0A5C\u0A5E]\u0A3C?|[\u0A05\u0A72\u0A73\u0A13])",
      "replace": "$1\u0A3F",
      "note": "The i-sign goes after its cluster (visual order -\u003E Unicode order); \u0A05 \u0A72 \u0A73 \u0A13 take it too."
    },
    {
      "pattern": "([\u0A47\u0A48\u0A4B\u0A4C])\\1",
      "replace": "$1",
      "note": "A vowel sign twice in a row draws one sign: the composer\u0027s own broken answer for \u0A20/\u0A28 \u002B subjoined \u002B a top sign \u002B bindi (\u0A20\u0A4D\u0A30\u0A47\u0A02 written 53 79 BE 7A, the subjoined form lost) reads as the one sign it shows."
    },
    {
      "pattern": "\u0A71\u0A02",
      "replace": "\u0A01",
      "note": "\u0A71 \u002B \u0A02 is \u0A01, as the Unicode composer writes it (\u0A15\u0A01 = 48 A7 A3)."
    },
    {
      "pattern": "\u0A72\u0A3F",
      "replace": "\u0A07",
      "note": "\u0A72 \u002B \u0A3F is \u0A07 (71 42): the vowels the Unicode composer writes for a carrier and a sign."
    },
    {
      "pattern": "\u0A72\u0A40",
      "replace": "\u0A08",
      "note": "\u0A72 \u002B \u0A40 is \u0A08 (42 72)."
    },
    {
      "pattern": "\u0A72\u0A47",
      "replace": "\u0A0F",
      "note": "\u0A72 \u002B \u0A47 is \u0A0F (42 79)."
    },
    {
      "pattern": "\u0A05\u0A3E",
      "replace": "\u0A06",
      "note": "\u0A05 \u002B \u0A3E is \u0A06 (41 70)."
    },
    {
      "pattern": "\u0A05\u0A48",
      "replace": "\u0A10",
      "note": "\u0A05 \u002B \u0A48 is \u0A10 (41 B1)."
    },
    {
      "pattern": "\u0A05\u0A4C",
      "replace": "\u0A14",
      "note": "\u0A05 \u002B \u0A4C is \u0A14 (41 A1)."
    },
    {
      "pattern": "\u0A73\u0A41",
      "replace": "\u0A09",
      "note": "\u0A73 \u002B \u0A41 is \u0A09."
    },
    {
      "pattern": "\u0A73\u0A42",
      "replace": "\u0A0A",
      "note": "\u0A73 \u002B \u0A42 is \u0A0A."
    },
    {
      "pattern": "\uFDD1",
      "replace": "",
      "note": "U\u002BFDD1 is not text."
    }
  ]
