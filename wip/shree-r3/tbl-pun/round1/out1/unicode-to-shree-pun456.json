  "preRules": [
    {
      "pattern": "\u0A16\u0A3C",
      "replace": "\u0A59",
      "note": "U\u002B0A16 \u002B nukta U\u002B0A3C is U\u002B0A59: normalised text keeps them apart (the nukta letters are composition exclusions); the composer writes the precomposed letter, one code."
    },
    {
      "pattern": "\u0A17\u0A3C",
      "replace": "\u0A5A",
      "note": "U\u002B0A17 \u002B nukta U\u002B0A3C is U\u002B0A5A: normalised text keeps them apart (the nukta letters are composition exclusions); the composer writes the precomposed letter, one code."
    },
    {
      "pattern": "\u0A1C\u0A3C",
      "replace": "\u0A5B",
      "note": "U\u002B0A1C \u002B nukta U\u002B0A3C is U\u002B0A5B: normalised text keeps them apart (the nukta letters are composition exclusions); the composer writes the precomposed letter, one code."
    },
    {
      "pattern": "\u0A2B\u0A3C",
      "replace": "\u0A5E",
      "note": "U\u002B0A2B \u002B nukta U\u002B0A3C is U\u002B0A5E: normalised text keeps them apart (the nukta letters are composition exclusions); the composer writes the precomposed letter, one code."
    },
    {
      "pattern": "\u0A32\u0A3C",
      "replace": "\u0A33",
      "note": "U\u002B0A32 \u002B nukta U\u002B0A3C is U\u002B0A33: normalised text keeps them apart (the nukta letters are composition exclusions); the composer writes the precomposed letter, one code."
    },
    {
      "pattern": "\u0A38\u0A3C",
      "replace": "\u0A36",
      "note": "U\u002B0A38 \u002B nukta U\u002B0A3C is U\u002B0A36: normalised text keeps them apart (the nukta letters are composition exclusions); the composer writes the precomposed letter, one code."
    },
    {
      "pattern": "(?\u003C=^|[\\s(\\[{\u201C\u2018\u2014\u2013-])\u0022",
      "replace": "\u201C",
      "note": "ASCII \u0022 that opens a quote (at the start, after a space, a bracket or a dash) is \u201C, two \u2018 (22 22)."
    },
    {
      "pattern": "\u0022",
      "replace": "\u201D",
      "note": "Any other ASCII \u0022 closes a quote: \u201D, two \u2019 (27 27)."
    },
    {
      "pattern": "(?\u003C=^|[\\s(\\[{\u201C\u2018\u2014\u2013-])\u0027",
      "replace": "\u2018",
      "note": "ASCII \u0027 that opens a quote is \u2018 (22)."
    },
    {
      "pattern": "\u0027",
      "replace": "\u2019",
      "note": "Any other ASCII \u0027 (a closing quote, an apostrophe) is \u2019 (27)."
    },
    {
      "pattern": "\u0A06",
      "replace": "\u0A05\u0A3E",
      "note": "\u0A06 is \u0A05 \u002B \u0A3E (41 70), \u0A10 \u0A05 \u002B \u0A48, \u0A14 \u0A05 \u002B \u0A4C: split, so the signs\u0027 own rules (a tippi written as bindi, the bindi ligatures, the far addak) apply."
    },
    {
      "pattern": "\u0A10",
      "replace": "\u0A05\u0A48",
      "note": "\u0A10 = \u0A05 \u002B \u0A48 (41 B1)."
    },
    {
      "pattern": "\u0A14",
      "replace": "\u0A05\u0A4C",
      "note": "\u0A14 = \u0A05 \u002B \u0A4C (41 A1)."
    },
    {
      "pattern": "\u0A07",
      "replace": "\u0A72\u0A3F",
      "note": "\u0A07 = \u0A72 \u002B \u0A3F, written 71 42 (the i-sign first; the code E4 that types \u0A07 writes nothing in the 7 composer)."
    },
    {
      "pattern": "\u0A08",
      "replace": "\u0A72\u0A40",
      "note": "\u0A08 = \u0A72 \u002B \u0A40 (42 72)."
    },
    {
      "pattern": "\u0A0F",
      "replace": "\u0A72\u0A47",
      "note": "\u0A0F = \u0A72 \u002B \u0A47 (42 79)."
    },
    {
      "pattern": "\u0A01",
      "replace": "\u0A71\u0A02",
      "note": "\u0A01 (adak bindi) is the addak and the bindi, A7 A3: the Unicode composer writes \u0A71 \u002B \u0A02 as U\u002B0A01."
    },
    {
      "pattern": "([\u0A3E\u0A40\u0A47\u0A48\u0A4B\u0A4C\u0A09\u0A0A\u0A73])\u0A70",
      "replace": "$1\u0A02",
      "note": "A tippi after \u0A3E \u0A40 \u0A47 \u0A48 \u0A4B \u0A4C \u0A09 \u0A0A \u0A73 is written as the bindi, as both of Shree\u0027s composers write it."
    },
    {
      "pattern": "((?:[\u0A15-\u0A28\u0A2A-\u0A30\u0A32\u0A33\u0A35\u0A36\u0A38\u0A39\u0A59-\u0A5C\u0A5E]\u0A3C?\u0A4D[\u200C\u200D]?)*[\u0A15-\u0A28\u0A2A-\u0A30\u0A32\u0A33\u0A35\u0A36\u0A38\u0A39\u0A59-\u0A5C\u0A5E]\u0A3C?|[\u0A05\u0A72\u0A73\u0A13])\u0A3F",
      "replace": "\u0A3F$1",
      "note": "The i-sign \u0A3F is written before its cluster (Unicode logical order -\u003E legacy visual order); \u0A05 \u0A72 \u0A73 \u0A13 take it in front too."
    },
    {
      "pattern": "([\u0A20\u0A28]\u0A3C?)",
      "replace": "$1\uFDD8",
      "note": "\u0A20 and \u0A28 are followed by the spacer BE (U\u002BFDD8 marks it)."
    },
    {
      "pattern": "([\u0A40\u0A47\u0A48\u0A4B\u0A4C\u0A02\u0A70\u0A09\u0A0A\u0A73])\u0A71",
      "replace": "$1\uFDDB",
      "note": "The addak after a mark that reaches the top (\u0A40 \u0A47 \u0A48 \u0A4B \u0A4C \u0A02 \u0A70) and after \u0A09 \u0A0A \u0A73 is A8, further right (U\u002BFDDB marks it); else A7."
    },
    {
      "pattern": "(?\u003C=[\u0A09\u0A0A]\uFDDB?[\u0A02\uFDDC]*)\u0A02",
      "replace": "\uFDDC",
      "note": "The bindi after \u0A09 \u0A0A is A4, to the right of the curl (U\u002BFDDC marks it): \u0A09\u0A02 = 45 A4, \u0A09\u0A01 = 45 A8 A4, \u0A09\u0A02\u0A02 = 45 A4 A4."
    },
    {
      "pattern": "\uFDD8((?:\u0A4D[\u0A30\u0A39\u0A35])?[\u0A02\u0A70\u0A71\u0A47\u0A48\u0A4B\u0A4C]\u002B)\u0A41",
      "replace": "\uFDD8$1\uFDD9",
      "note": "\u0A41 typed after a mark on top of \u0A20/\u0A28 (\u0A28\u0A70\u0A41): AE (U\u002BFDD9) - the composer\u0027s answer for that order (\u0A28\u0A70\u0A42 = B2 A5 BE AF, where \u0A28\u0A42\u0A70 is B2 A5 BE 76)."
    },
    {
      "pattern": "\uFDD8((?:\u0A4D[\u0A30\u0A39\u0A35])?[\u0A02\u0A70\u0A71\u0A47\u0A48\u0A4B\u0A4C]\u002B)\u0A42",
      "replace": "\uFDD8$1\uFDDA",
      "note": "\u0A42 there: AF (U\u002BFDDA)."
    },
    {
      "pattern": "\uFDD8((?:\u0A4D[\u0A30\u0A39\u0A35])?)\u0A41(?![\u0A02\u0A70\u0A71\u0A47\u0A48\u0A4B\u0A4C])",
      "replace": "\uFDD8$1\uFDD9",
      "note": "\u0A41 after \u0A20/\u0A28\u0027s spacer (and a subjoined \u0A4D\u0A30 \u0A4D\u0A39 \u0A4D\u0A35) with no mark on top: AE (U\u002BFDD9)."
    },
    {
      "pattern": "\uFDD8((?:\u0A4D[\u0A30\u0A39\u0A35])?)\u0A42(?![\u0A02\u0A70\u0A71\u0A47\u0A48\u0A4B\u0A4C])",
      "replace": "\uFDD8$1\uFDDA",
      "note": "\u0A42 there: AF (U\u002BFDDA)."
    },
    {
      "pattern": "\uFDD8((?:\u0A4D[\u0A30\u0A39\u0A35])?[\u0A41\u0A42]?)([\u0A02\u0A70\u0A71\u0A47\u0A48\u0A4B\u0A4C]\u002B)",
      "replace": "$2\uFDD8$1",
      "note": "The marks on top of \u0A20/\u0A28 (\u0A47 \u0A48 \u0A4B \u0A4C \u0A02 \u0A70 and the near addak) go before its spacer; \u0A3E \u0A40, the halant, \u0A4D\u0A2F and \u0A03 stay after it, and \u0A41 \u0A42 (then 74 76) and \u0A4D\u0A30 \u0A4D\u0A39 \u0A4D\u0A35 go after it."
    }
