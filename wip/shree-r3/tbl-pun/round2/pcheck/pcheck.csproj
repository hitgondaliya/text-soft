<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>pcheck</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <NoWarn>CS8618;CS8602;CS8604;CS8600;CS0168;CS8625</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\repo\src\FontSoftware.Core\FontSoftware.Core.csproj" />
    <ProjectReference Include="..\..\repo\src\FontSoftware.Engine\FontSoftware.Engine.csproj" />
  </ItemGroup>
</Project>
